```python
import pygame
import random
import os # Для работы с путями к файлам, если будем добавлять изображения

# --- Инициализация Pygame ---
pygame.init()
pygame.font.init() # Инициализация модуля шрифтов

# --- Константы игры ---
WIDTH, HEIGHT = 800, 600 # Размеры окна
FPS = 60 # Кадры в секунду

# Цвета (RGB)
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)
GREEN = (0, 255, 0)
BLUE = (0, 0, 255)
YELLOW = (255, 255, 0)
GREY = (100, 100, 100)

# --- Настройка окна ---
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Простой Космический Шутер")
clock = pygame.time.Clock()

# --- Шрифты ---
font_name = pygame.font.match_font('arial') # Выбираем шрифт
def draw_text(surf, text, size, x, y):
    font = pygame.font.Font(font_name, size)
    text_surface = font.render(text, True, WHITE) # True для сглаживания
    text_rect = text_surface.get_rect()
    text_rect.midtop = (x, y)
    surf.blit(text_surface, text_rect)

# --- Класс Игрока ---
class Player(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        # Для простоты, игрок - это синий прямоугольник.
        # В реальной игре здесь будет загружаться изображение.
        self.image = pygame.Surface((50, 40))
        self.image.fill(BLUE) # Закрашиваем синим
        
        # Получаем прямоугольник из поверхности для позиционирования
        self.rect = self.image.get_rect()
        self.rect.centerx = WIDTH // 2 # Начинаем по центру экрана
        self.rect.bottom = HEIGHT - 10 # Внизу экрана, немного отступая
        
        self.speed = 8 # Скорость перемещения игрока
        self.shoot_delay = 250 # Задержка между выстрелами (в мс)
        self.last_shot = pygame.time.get_ticks() # Время последнего выстрела

    def update(self):
        # Получаем состояние всех нажатых клавиш
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT]: # Если нажата стрелка влево
            self.rect.x -= self.speed
        if keys[pygame.K_RIGHT]: # Если нажата стрелка вправо
            self.rect.x += self.speed

        # Удерживаем игрока в пределах экрана
        if self.rect.left < 0:
            self.rect.left = 0
        if self.rect.right > WIDTH:
            self.rect.right = WIDTH

    def shoot(self):
        now = pygame.time.get_ticks() # Текущее время
        if now - self.last_shot > self.shoot_delay:
            self.last_shot = now
            bullet = Bullet(self.rect.centerx, self.rect.top) # Создаем пулю
            all_sprites.add(bullet) # Добавляем пулю в группу всех спрайтов
            bullets.add(bullet) # Добавляем пулю в группу пуль

# --- Класс Врага (Астероид) ---
class Enemy(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        # Враг - это красный прямоугольник
        self.image = pygame.Surface((30, 30))
        self.image.fill(RED)
        
        self.rect = self.image.get_rect()
        self.rect.x = random.randrange(WIDTH - self.rect.width) # Случайная позиция по X
        self.rect.y = random.randrange(-100, -40) # Начинаем выше экрана
        
        self.speed_y = random.randrange(1, 8) # Случайная скорость падения
        self.speed_x = random.randrange(-3, 3) # Случайная горизонтальная скорость (для разнообразия)

    def update(self):
        self.rect.y += self.speed_y
        self.rect.x += self.speed_x
        
        # Если враг вышел за границы экрана, перемещаем его наверх для повторного появления
        if self.rect.top > HEIGHT + 10 or self.rect.left < -25 or self.rect.right > WIDTH + 25:
            self.rect.x = random.randrange(WIDTH - self.rect.width)
            self.rect.y = random.randrange(-100, -40)
            self.speed_y = random.randrange(1, 8)
            self.speed_x = random.randrange(-3, 3)

# --- Класс Пули ---
class Bullet(pygame.sprite.Sprite):
    def __init__(self, x, y):
        super().__init__()
        # Пуля - это маленький зеленый прямоугольник
        self.image = pygame.Surface((5, 15))
        self.image.fill(GREEN)
        
        self.rect = self.image.get_rect()
        self.rect.centerx = x # Позиция X от центра игрока
        self.rect.bottom = y # Позиция Y от верха игрока
        
        self.speed = -10 # Скорость пули (отрицательная, чтобы летела вверх)

    def update(self):
        self.rect.y += self.speed
        # Если пуля вышла за верхний край экрана, удаляем её
        if self.rect.bottom < 0:
            self.kill() # kill() удаляет спрайт из всех групп, в которых он состоит

# --- Настройка игровых объектов ---
all_sprites = pygame.sprite.Group() # Группа для всех спрайтов
enemies = pygame.sprite.Group() # Группа для врагов
bullets = pygame.sprite.Group() # Группа для пуль

player = Player()
all_sprites.add(player) # Добавляем игрока в группу всех спрайтов

# Создаем начальное количество врагов
for i in range(8):
    e = Enemy()
    all_sprites.add(e)
    enemies.add(e)

score = 0
game_over = False

# --- Основной игровой цикл ---
running = True
while running:
    # Ограничиваем FPS
    clock.tick(FPS)

    # --- Обработка событий ---
    for event in pygame.event.get():
        # Закрытие окна
        if event.type == pygame.QUIT:
            running = False
        # Нажатие клавиши
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE: # Если нажата пробел
                player.shoot()

    if not game_over:
        # --- Обновление всех спрайтов ---
        all_sprites.update()

        # --- Проверка столкновений ---
        # Столкновения пули с врагом:
        # groupcollide(group1, group2, dokill1, dokill2)
        # dokill1=True: удаляет спрайты из group1, которые столкнулись
        # dokill2=True: удаляет спрайты из group2, которые столкнулись
        hits = pygame.sprite.groupcollide(enemies, bullets, True, True)
        for hit in hits: # Каждый "hit" - это враг, который был подбит
            score += 10 # Увеличиваем очки
            e = Enemy() # Создаем нового врага взамен уничтоженного
            all_sprites.add(e)
            enemies.add(e)

        # Столкновения игрока с врагом:
        # spritecollide(sprite, group, dokill)
        # dokill=False: не удаляет врага при столкновении с игроком (иначе он просто исчезнет)
        hits = pygame.sprite.spritecollide(player, enemies, False)
        if hits:
            game_over = True # Игра заканчивается при столкновении игрока с врагом

    # --- Отрисовка ---
    screen.fill(BLACK) # Заливаем фон черным цветом
    all_sprites.draw(screen) # Рисуем все спрайты
    
    # Рисуем счет
    draw_text(screen, f"Score: {score}", 25, WIDTH // 2, 10)

    # Если игра окончена, выводим сообщение
    if game_over:
        draw_text(screen, "GAME OVER", 50, WIDTH // 2, HEIGHT // 2 - 20)
        draw_text(screen, "Press R to Restart", 30, WIDTH // 2, HEIGHT // 2 + 30)
        
        # Проверяем нажатие R для перезапуска
        keys = pygame.key.get_pressed()
        if keys[pygame.K_r]:
            # Сброс игры
            score = 0
            game_over = False
            
            # Очищаем и заново создаем спрайты
            all_sprites.empty()
            enemies.empty()
            bullets.empty()
            
            player = Player()
            all_sprites.add(player)
            for i in range(8):
                e = Enemy()
                all_sprites.add(e)
                enemies.add(e)


    # Обновляем весь экран
    pygame.display.flip()

# --- Завершение Pygame ---
pygame.quit()
```

